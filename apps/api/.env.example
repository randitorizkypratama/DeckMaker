# DuelDex API configuration

# Upstream card data source.
YGOPRODECK_API_URL=https://db.ygoprodeck.com/api/v7

# Port the API listens on.
API_PORT=3001

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Base URL of the web app, used when building share links.
PUBLIC_WEB_URL=http://localhost:3000

# SQLite database file for users, decks and favorites.
DATABASE_PATH=./data/dueldex.sqlite

# JWT secret for auth tokens (change in production).
JWT_SECRET=dev-secret-change-me-please-use-strong-random-string

# Upstream request timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=12000

# In-process card cache TTL in milliseconds (default 1 hour).
CACHE_TTL_MS=3600000
